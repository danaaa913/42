# Copy these values into your shell or .env loader before the hackathon.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=embeddinggemma
# Leave empty unless the selected embedding model requires special prefixes.
OLLAMA_EMBED_QUERY_PREFIX=
OLLAMA_EMBED_DOCUMENT_PREFIX=

HACKATHON_DOCUMENTS_DIR=hackathon_workspace/documents
HACKATHON_INDEX_DIR=hackathon_workspace/index
HACKATHON_PARENT_SIZE=3600
HACKATHON_CHILD_SIZE=900
HACKATHON_CHILD_OVERLAP=140
HACKATHON_MIN_CHUNK_SIZE=100
HACKATHON_RETRIEVE_CANDIDATES=24
HACKATHON_FINAL_K=6
HACKATHON_MAX_PER_SOURCE=2
HACKATHON_MAX_CONTEXT_CHARS=14000
# High-risk instruction-like content is reported and excluded until reviewed.
HACKATHON_QUARANTINE_SUSPICIOUS=true
# Exclude files with likely identity, financial, card, or credential values until reviewed.
HACKATHON_QUARANTINE_SENSITIVE=true
# Stores hashes, IDs and timings only; raw questions and answers are not logged.
HACKATHON_TRACE_ENABLED=true

# FastAPI web server. Localhost works without a token. Any network bind through
# hackathon_api.py is refused until HACKATHON_API_TOKEN is set.
HACKATHON_API_HOST=127.0.0.1
HACKATHON_API_PORT=8000
HACKATHON_API_TOKEN=
# Keep this at 1 on a laptop so concurrent generations do not compete for RAM/VRAM.
HACKATHON_MAX_CONCURRENT_QUESTIONS=1
