# Copy these values into your shell before running the competition.

# Ollama engine (local only).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=command-r7b-arabic:7b
OLLAMA_EMBED_MODEL=embeddinggemma

# Optional local web UI (hackathon_api.py). Localhost needs no token.
HACKATHON_API_HOST=127.0.0.1
HACKATHON_API_PORT=8000
HACKATHON_API_TOKEN=
HACKATHON_MAX_CONCURRENT_QUESTIONS=1
